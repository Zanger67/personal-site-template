---
import BaseLayout from '../layouts/BaseLayout.astro';
import NorthAmericaMap from '../components/NorthAmericaMap.astro';
import AffiliationGroups from '../components/AffiliationGroups.astro';
import { showHomeSection, isRouteEnabled, friendsFirstNameOnly, enabledFooterLinks } from '@config/site';
import { getCollection, getEntry, render } from 'astro:content';
import { resolvePeople, collaboratorHref, personWebsite, personLinkedIn } from '../utils/collaborators';
import { withIncoming } from '../utils/incoming';
import { fmtFullDate } from '../utils/works';
import profile from '../data/profile.json';
import affiliations from '../data/affiliations.json';
import publications from '../data/publications.json';
import education from '../data/education.json';
import languages from '../data/languages.json';
import organizations from '../data/organizations.json';
import awards from '../data/awards.json';
import { buildPersonGraph } from '../utils/structuredData';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const profileShape = profile.profileShape as 'circle' | 'rectangle';

// Affiliations use the same org-array shape as organizations.json (see
// experience.astro). What appears in this homepage sidebar is an EXPLICIT
// curation, independent of the timeline's current/past: a role (or the blanket
// `membership`) opts in with `homepage: true`. Each org that contributes at
// least one homepage row is listed, with its opted-in role names (+ a "Member"
// row when the membership is featured). A homepage role may also carry
// `homepage_org_name` to override the group's title here (e.g. a short form)
// without affecting the org's full name used elsewhere.
// A future-dated role/membership (start month later than now) is tagged
// "(incoming)" here just as on the experience page, via the shared withIncoming
// helper — so a homepage-featured role that hasn't begun reads the same way.
// The opted-in rows then split into two blocks by whether they have FINISHED:
// still-running rows head the sidebar as "Affiliations (current)", ended ones
// fall into the "Affiliations (past)" disclosure below, closed by default. The
// opt-in is the same either way — `homepage: false` keeps a row off both.
interface AffilRole { role: string; roleDetail?: string; start?: string | null; end?: string | null; homepage?: boolean; homepage_org_name?: string; }
interface AffilOrg {
  organization: string;
  url?: string | null;
  membership?: { start?: string | null; end?: string | null; homepage?: boolean };
  roles?: AffilRole[];
}
const affilOrgs = affiliations as AffilOrg[];

// Month-granular comparison on the raw YYYY-MM / YYYY strings (as in
// utils/incoming.ts), so no Date parsing of the source data is needed. 0 stands
// for "no end", which sorts last and never reads as past.
function monthIdx(d?: string | null): number {
  if (!d) return 0;
  const [y, m] = d.split('-').map(Number);
  return Number.isFinite(y) ? y * 12 + (Number.isFinite(m) ? m - 1 : 0) : 0;
}
const nowMonthIdx = new Date().getFullYear() * 12 + new Date().getMonth();
// Past = ended before this month. An open-ended row, or one ending in the
// current month, is still current.
const hasEnded = (end?: string | null): boolean => monthIdx(end) > 0 && monthIdx(end) < nowMonthIdx;

// Every org contributing at least one homepage row of the requested kind, with
// just those rows. An org with both a running and a finished homepage row is
// listed in both blocks, each showing only its own rows.
function homepageGroups(want: 'current' | 'past') {
  return affilOrgs
    .map(o => {
      const homepageRoles = (o.roles ?? []).filter(r => r.homepage);
      const homepageOrgName = homepageRoles.find(r => r.homepage_org_name)?.homepage_org_name;
      const rows = [
        ...homepageRoles
          .filter(r => hasEnded(r.end) === (want === 'past'))
          .map(r => ({ label: withIncoming(r.roleDetail ?? r.role, r.start), end: r.end })),
        ...(o.membership?.homepage && hasEnded(o.membership.end) === (want === 'past')
          ? [{ label: withIncoming('Member', o.membership.start), end: o.membership.end }]
          : []),
      ];
      return {
        entity: homepageOrgName ?? o.organization,
        url: o.url ?? null,
        roles: rows.map(r => r.label),
        latestEnd: Math.max(0, ...rows.map(r => monthIdx(r.end))),
      };
    })
    .filter(g => g.roles.length > 0);
}
// Current keeps the data's own order; past reads most-recently-ended first.
const currentGroups = homepageGroups('current');
const pastGroups = homepageGroups('past').sort((a, b) => b.latestEnd - a.latestEnd);

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

type ProjectEntry = { data: { endDate?: Date; startDate: Date } };
function projectSort(a: ProjectEntry, b: ProjectEntry): number {
  if (!a.data.endDate && b.data.endDate) return -1;
  if (a.data.endDate && !b.data.endDate) return 1;
  const endDiff = (b.data.endDate?.valueOf() ?? 0) - (a.data.endDate?.valueOf() ?? 0);
  if (endDiff !== 0) return endDiff;
  return b.data.startDate.valueOf() - a.data.startDate.valueOf();
}
const allProjects = (await getCollection('projects')).sort(projectSort);
const projects = [
  ...allProjects.filter(p => p.data.pinned),
  ...allProjects.filter(p => !p.data.pinned),
].slice(0, 3);

const introEntry = await getEntry('sections', 'intro');
const { Content: Intro } = await render(introEntry);

// schema.org JSON-LD identity graph (Person + work/education history, projects,
// publications) — machine-readable context for search engines and LLMs, emitted
// invisibly in the page. Data-driven from the same sources the page renders.
const siteUrl = (Astro.site?.href ?? '').replace(/\/+$/, '') + base;
const personGraph = buildPersonGraph({
  siteUrl,
  profile,
  affiliations,
  organizations,
  education,
  awards,
  publications,
  projects: allProjects.filter(p => !p.data.draft),
  socials: enabledFooterLinks.filter(l => l.external).map(l => l.href),
});
---

<BaseLayout title={profile.homeTitle} rawTitle>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personGraph).replace(/</g, '\\u003c')} />
  <div class="home-layout">
    <aside class="sidebar">
      <img
        src={`${base}${profile.profileImage}`}
        alt="Profile photo"
        class:list={['profile-img', { 'profile-rect': profileShape === 'rectangle' }]}
        width="150"
        height="150"
      />

      {showHomeSection('education') && education.length > 0 && (
        <div class="sidebar-section">
          <h3>Education</h3>
          <div class="edu-list">
            {education.map(ed => (
              <div class="edu-item">
                <div class="edu-degree">{ed.degree}</div>
                <div class="edu-school">
                  {ed.url
                    ? <a href={ed.url} target="_blank" rel="noopener noreferrer">{ed.institutionShort ?? ed.institution}</a>
                    : ed.institutionShort ?? ed.institution}
                </div>
                {ed.honors && <div class="edu-honors">{ed.honors}</div>}
              </div>
            ))}
          </div>
        </div>
      )}

      {showHomeSection('affiliations') && (currentGroups.length > 0 || pastGroups.length > 0) && (
        <div class="sidebar-section">
          {currentGroups.length > 0 && (
            <Fragment>
              <h3>Affiliations (current)</h3>
              <AffiliationGroups groups={currentGroups} />
            </Fragment>
          )}
          {pastGroups.length > 0 && (
            <details class="aff-past">
              <summary>
                <span class="aff-past-label">Affiliations (past)</span>
                <span class="chev" aria-hidden="true"></span>
              </summary>
              <div class="aff-past-body">
                <AffiliationGroups groups={pastGroups} />
              </div>
            </details>
          )}
          {isRouteEnabled('experience') && <a href={`${base}/experience`} class="view-all">All experience &rarr;</a>}
        </div>
      )}

      {showHomeSection('languages') && languages.length > 0 && (
        <div class="sidebar-section">
          <h3>Languages</h3>
          <div class="lang-list">
            {languages.map(lang => (
              <div class="lang-item">
                <span class="lang-name">{lang.language}</span>
                <span class="lang-fluency">{lang.fluency}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </aside>

    <div class="main-col">
      <h1>{profile.greeting}</h1>
      <p class="subtitle">{profile.subtitle}</p>
      <div class="intro"><Intro /></div>

      {showHomeSection('places') && (
        <section>
          <div class="section-header">
            <h2>Places</h2>
            {isRouteEnabled('map') && <a href={`${base}/map`}>View full map &rarr;</a>}
          </div>
          <NorthAmericaMap />
        </section>
      )}

      {showHomeSection('projects') && isRouteEnabled('projects') && projects.length > 0 && (
        <section>
          <div class="section-header">
            <h2>Projects</h2>
            <a href={`${base}/works#projects`}>View all &rarr;</a>
          </div>
          <ul class="link-list">
            {projects.map(project => (
              <li>
                <a href={`${base}/projects/${project.id}`}>{project.data.title}</a>
                <span class="muted"> &mdash; {project.data.description}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {showHomeSection('publications') && isRouteEnabled('publications') && publications.length > 0 && (
        <section>
          <div class="section-header">
            <h2>Publications</h2>
            <a href={`${base}/works#publications`}>View all &rarr;</a>
          </div>
          <ul class="link-list">
            {publications.slice(0, 3).map(pub => (
              <li>
                {pub.url
                  ? <a href={pub.url} target="_blank" rel="noopener noreferrer">{pub.title}</a>
                  : <span class="pub-title">{pub.title}</span>}
                <span class="muted"> &mdash; {pub.venue}, {pub.date}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {showHomeSection('recentPosts') && isRouteEnabled('blog') && posts.length > 0 && (
        <section>
          <div class="section-header">
            <h2>Recent Posts</h2>
            <a href={`${base}/works#blog`}>View all &rarr;</a>
          </div>
          <ul class="link-list">
            {posts.map(post => (
              <li>
                <a href={`${base}/blog/${post.id}`}>{post.data.title}</a>
                <span class="muted"> &mdash; {fmtFullDate(post.data.date)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {showHomeSection('friends') && (
        <section>
          <div class="section-header">
            <h2>Misc.</h2>
          </div>
          <div class="misc-row">
            <span class="misc-label">{profile.friendsLabel}:</span>
            <ul class="inline-list">
              {/* Friends are name references into the shared people registry
                  (src/data/collaborators.json) — same source projects/publications
                  resolve names from. A friend links OUT by preference: their own
                  website first, else their LinkedIn. Only someone with neither
                  falls back to their /collaborators dropdown (which opens them,
                  scrolls and flashes on arrival), then to any other primary
                  `url`; an unknown name renders as plain text. */}
              {resolvePeople(profile.friends).map(friend => {
                const label = friendsFirstNameOnly() ? friend.name.split(' ')[0] : friend.name;
                const out = personWebsite(friend) ?? personLinkedIn(friend);
                const href = out ?? (friend.listed ? collaboratorHref(friend.slug) : friend.url);
                const external = !!out || (!friend.listed && !!friend.url);
                return (
                  <li>
                    {href
                      ? <a href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{label}</a>
                      : <span>{label}</span>}
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      )}

      {profile.llmNote && (
        <p class="llm-note"><em>{profile.llmNote}</em></p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .home-layout {
    display: flex;
    gap: 2.5rem;
  }

  :global(main:has(.home-layout)) {
    max-width: 1012px;
  }

  .main-col {
    flex: 1;
    min-width: 0;
    order: 1;
  }

  .main-col h1 {
    font-size: 1.75rem;
    margin-bottom: 0.2rem;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 1rem;
  }

  .intro {
    margin-bottom: 2rem;
  }

  .llm-note {
    font-size: 0.7rem;
    color: var(--text-muted);
    opacity: 0.5;
    margin-top: 2rem;
  }

  /* Sidebar */

  .sidebar {
    width: 230px;
    flex-shrink: 0;
    padding-top: 0.25rem;
    order: 2;
  }

  .profile-img {
    border-radius: 50%;
    display: block;
    margin-bottom: 1.25rem;
    object-fit: cover;
  }

  .profile-img.profile-rect {
    border-radius: 8px;
    width: 100%;
    height: auto;
  }

  .sidebar-section {
    margin-bottom: 1.5rem;
  }

  .sidebar-section:last-child {
    margin-bottom: 0;
  }

  .sidebar-section h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  /* Past affiliations: the same tree, folded behind a disclosure so the sidebar
     leads with what's current. Closed by default; the rows sit in the markup
     either way, so crawlers and Ctrl-F still see them. */
  .aff-past {
    margin-top: 0.9rem;
  }

  .aff-past summary {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    cursor: pointer;
    list-style: none;               /* hide the native marker (Firefox) */
  }

  .aff-past summary::-webkit-details-marker { display: none; }

  /* Reads as a sibling of the section's h3 without being a second heading. */
  .aff-past-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .aff-past summary:hover .aff-past-label,
  .aff-past summary:hover .chev {
    color: var(--text);
    border-color: var(--text);
  }

  .chev {
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
    flex: none;
  }

  .aff-past[open] .chev {
    transform: rotate(45deg);
  }

  .aff-past-body {
    margin-top: 0.5rem;
  }

  .view-all {
    display: inline-block;
    font-size: 0.78rem;
    margin-top: 0.75rem;
  }

  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .edu-degree {
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .edu-school {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .edu-honors {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .lang-list {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .lang-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
  }

  .lang-name {
    font-weight: 500;
  }

  .lang-fluency {
    color: var(--text-muted);
  }

  /* Main column sections */

  section {
    margin-bottom: 2rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    margin-bottom: 0;
  }

  .section-header a {
    font-size: 0.85rem;
  }

  .link-list {
    list-style: none;
    padding: 0;
  }

  .link-list li {
    padding: 0.4rem 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .pub-title {
    font-size: 0.95rem;
  }

  .muted {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .misc-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.92rem;
  }

  .misc-label {
    color: var(--text-muted);
    font-weight: 500;
  }

  .inline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
  }

  .inline-list li {
    display: inline;
  }

  .inline-list li:not(:last-child)::after {
    content: '·';
    color: var(--text-muted);
    margin: 0 0.4rem;
  }

  @media (max-width: 640px) {
    .home-layout {
      flex-direction: column;
      gap: 1.5rem;
    }

    .main-col {
      order: 2;
    }

    .sidebar {
      order: 1;
    }

    :global(main:has(.home-layout)) {
      max-width: var(--max-width);
    }

    /* Profile image + the three sidebar sections (education, affiliations,
       languages) flow into two height-balanced columns instead of one
       squished row, so the four items settle into roughly 2x2. column-fill
       defaults to balance, which splits by content height (first half /
       second half when heights are even); break-inside keeps each item
       whole within a column. */
    .sidebar {
      width: 100%;
      columns: 2;
      column-gap: 1rem;
    }

    .sidebar > * {
      break-inside: avoid;
      margin: 0 0 1.25rem;
    }

    .sidebar > *:last-child {
      margin-bottom: 0;
    }

    /* Image sits at 90% of the column width. aspect-ratio keeps the circle
       square; the rectangle keeps its natural portrait ratio. */
    .profile-img {
      width: 90%;
      height: auto;
      aspect-ratio: 1;
    }

    .profile-img.profile-rect {
      width: 90%;
      aspect-ratio: auto;
    }
  }
</style>
