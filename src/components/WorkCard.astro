---
// The single, standardized card used by every tab of the Works page
// (Recent activity, Publications, Projects, Blog). One layout so the header
// font/size/style, the date, the tags row, and the Live/Repo/link chips are
// identical everywhere — a tab only differs in the data it feeds in.
//
// Featured placement:
//   • Recent activity passes `kind` ("Project"/"Publication"/"Blog"), so the
//     "★ Featured" tag rides the top type-row alongside the kind label.
//   • Every other tab omits `kind`, so "★ Featured" sits in the header row
//     next to the title (the tab itself already says what the item is).
import Metrics from './Metrics.astro';
import CreditMarks from './CreditMarks.astro';
import { legendOf, isOrgLevel, type MarkInfo } from '../utils/marks';
import { permanentInstitutionLegend } from '@config/site';
import { normalizeMetrics, type Metrics as MetricsDict } from '../utils/metrics';

interface WorkLink {
  label: string;
  url: string;
}

// One credited name on a card (publications). Pre-resolved by the caller so this
// component stays a dumb renderer: `href` already points wherever the name should
// go (a /collaborators dropdown, or the person's own site when `external`), and
// `marks` carries the item's marks + legend text — its institution numbers first,
// then its contributor-level symbols ("Buzz¹†").
interface AuthorChip {
  name: string;
  href?: string | null;
  external?: boolean;
  /** Me — rendered bold and never linked. */
  self?: boolean;
  marks?: MarkInfo[];
}

interface Props {
  title: string;
  /** Title link. Internal URLs are already base-prefixed; external ones open in a new tab. */
  href?: string | null;
  /** Open `href` in a new tab (external links). */
  external?: boolean;
  /** Date range / date / date + reading-time — rendered at the end of the header row. */
  dateLabel?: string | null;
  /** Muted blurb under the header (description / authors). */
  description?: string | null;
  /** Optional italic line between header and description (e.g. a publication venue). */
  subtitle?: string | null;
  /** Credited names (publications) — rendered as their own line, each linked. */
  authors?: AuthorChip[];
  /** Affiliated orgs/labs — rendered as distinct outlined chips before the tags. */
  affiliations?: string[];
  tags?: string[];
  /** Generic stat chips (Repo Stars, Citations, …) — rendered on their own row. */
  metrics?: MetricsDict | null;
  /** Live / Repo / extra links — rendered as chips; simply omitted when empty. */
  links?: WorkLink[];
  /** `main`-flagged highlight — shows a "★ Featured" tag. */
  featured?: boolean;
  /** Recent-activity type label ("Project"/"Publication"/"Blog"). Omit on single-type tabs. */
  kind?: string | null;
  /** Colour for the kind swatch (experience-timeline category colour). */
  kindColor?: string | null;
}

const {
  title,
  href = null,
  external = false,
  dateLabel = null,
  description = null,
  subtitle = null,
  authors = [],
  affiliations = [],
  tags = [],
  metrics = null,
  links = [],
  featured = false,
  kind = null,
  kindColor = null,
} = Astro.props;

const extAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const hasMetrics = normalizeMetrics(metrics).length > 0;
// The item's whole legend, read straight off the credited names — every name's
// hover popup shows all of it, its own rows highlighted.
const authorLegend = legendOf(authors.map(a => a.marks));
// The INSTITUTION half of it is also printed openly under the names, unlike the
// contributor symbols: an emoji mark is only a guess without its key, and a hover
// popup is unreachable by touch. Contributor symbols stay in the popup — "†" reads
// as a footnote on its own, and its meaning is the same on every card.
//   Config-gated on its own (`authorInstitutions.permanentLegend`, 'none' by
// default): with no permanent legend the marks stay on the names and the hover
// popup remains their only explanation.
const legendMode = permanentInstitutionLegend();
const affilKey = legendMode === 'below'
  ? authorLegend.filter(l => isOrgLevel(l.level) && l.note)
  : [];
// 'aside' instead puts the WHOLE legend — both families — in its own column beside
// the item, in the page margin: absolutely positioned off the card, so the works
// column keeps exactly the width it has without a legend, and every card's legend
// lines up at the same edge. It's the popup's content at a fixed address rather
// than one that follows the cursor — it fades in while a name is hovered (see the
// script below), lighting that person's own rows, and fades back out.
//   The margin only exists on a wide enough viewport; under the breakpoint the CSS
// hides it and the ordinary floating popup takes over, which is why the names keep
// theirs rather than having it suppressed here.
const asideLegend = legendMode === 'aside' ? authorLegend.filter(l => l.note) : [];
---

{/* `.work-main` is always present so the card's markup doesn't change shape with
    the config; it only becomes a column when there's an aside to sit beside. */}
<article class:list={['work-card', asideLegend.length > 0 && 'has-aside']}>
  <div class="work-main">
  {kind && (
    <div class="work-typerow">
      <span class="work-kind" style={kindColor ? `--cat: ${kindColor}` : undefined}>{kind}</span>
      {featured && <span class="featured-tag" title="Featured — flagged as a highlight">★ Featured</span>}
    </div>
  )}

  <div class="work-header">
    <div class="work-title-wrap">
      <h3 class="work-title">
        {href
          ? <a href={href} {...extAttrs}>{title}</a>
          : title}
      </h3>
      {!kind && featured && <span class="featured-tag" title="Featured — flagged as a highlight">★ Featured</span>}
    </div>
    {dateLabel && <span class="work-date">{dateLabel}</span>}
  </div>

  {subtitle && <p class="work-subtitle">{subtitle}</p>}
  {authors.length > 0 && (
    <p class="work-authors">
      {authors.map((a, i) => (
        <Fragment>
          {i > 0 && ', '}
          <CreditMarks marks={a.marks ?? []} legend={authorLegend}>
            {a.self
              ? <strong class="me">{a.name}</strong>
              : a.href
                ? <a href={a.href} {...(a.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{a.name}</a>
                : <span>{a.name}</span>}</CreditMarks></Fragment>
      ))}
    </p>
  )}
  {/* The institution key. Hidden from screen readers, which already heard each
      one inline on the name that carries it (see CreditMarks). */}
  {affilKey.length > 0 && (
    <p class="work-affilkey" aria-hidden="true">
      {affilKey.map((l, i) => (
        <Fragment>
          {i > 0 && <span class="sep">·</span>}
          <span class="work-affil">
            <span class="work-affil-mark">{l.symbol}</span>
            {l.icon && (l.icon.kind === 'image'
              ? <img class="affil-icon" src={l.icon.value} alt="" loading="lazy" decoding="async" />
              : <span class="affil-icon">{l.icon.value}</span>)}
            {l.note}
          </span>
        </Fragment>
      ))}
    </p>
  )}
  {description && <p class="work-desc">{description}</p>}

  {/* Four independent groups (affiliations · tags · metrics · links). Base render
      is one wrapping row; the client script below measures each card's own content
      and, only on overflow, progressively splits it across two lines — see the
      <script> and the `.work-metarow` styles for the staged cascade. */}
  {(affiliations.length > 0 || tags.length > 0 || links.length > 0 || hasMetrics) && (
    <div class="work-metarow" data-stage="0">
      {affiliations.length > 0 && (
        <div class="mr-group mr-affil">
          {affiliations.map(a => <span class="affil-chip" title={`Affiliated with ${a}`}>{a}</span>)}
        </div>
      )}
      {tags.length > 0 && (
        <div class="mr-group mr-tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
      <Metrics metrics={metrics} class="mr-group mr-metrics" />
      {links.length > 0 && (
        <div class="mr-group mr-links ext-links">
          {links.map(l => (
            <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>
          ))}
        </div>
      )}
    </div>
  )}
  </div>

  {/* The static legend. Hidden from screen readers, which already heard each
      meaning inline on the name that carries it (see CreditMarks). */}
  {asideLegend.length > 0 && (
    <aside class="work-aside" aria-hidden="true">
      {asideLegend.map(l => (
        <span class:list={['wa-row', isOrgLevel(l.level) && 'wa-org']} data-level={l.level}>
          <span class="wa-sym">{l.symbol}</span>
          {l.icon && (l.icon.kind === 'image'
            ? <img class="affil-icon" src={l.icon.value} alt="" loading="lazy" decoding="async" />
            : <span class="affil-icon">{l.icon.value}</span>)}
          {l.note}
        </span>
      ))}
    </aside>
  )}
</article>

{/* Progressive-collapse for each card's meta row. Faithful to a *content*-overflow
    cascade (not fixed width breakpoints) so each card reacts to its OWN content:
      stage 0   A T M L              everything on one line
      stage 1   A / T M L            affiliations drop to their own line
      stage 2   A M / T L            metrics move up beside the affiliations
      stage 3   A M / T…(wrap) L     tags wrap; links tie to the bottom tag row
    Hoisted + deduped by Astro, so this one script drives every card on the page.
    With JS off, the base CSS leaves it as a single wrapping row. */}
<script>
  interface Groups {
    affil: HTMLElement | null;
    tags: HTMLElement | null;
    metrics: HTMLElement | null;
    links: HTMLElement | null;
  }

  const px = (v: string) => {
    const n = parseFloat(v);
    return Number.isFinite(n) ? n : 0;
  };

  // Natural single-line width of a chip group = Σ child widths + inner column-gaps.
  // Chip widths don't depend on wrapping, so this is stable wherever the group
  // currently sits (line 1, line 2, or already wrapped across rows).
  const naturalWidth = (g: HTMLElement | null): number => {
    if (!g) return 0;
    const kids = Array.from(g.children) as HTMLElement[];
    if (!kids.length) return 0;
    const gap = px(getComputedStyle(g).columnGap);
    let w = 0;
    for (const k of kids) w += k.getBoundingClientRect().width;
    return w + gap * (kids.length - 1);
  };

  const setup = (row: HTMLElement) => {
    const groups: Groups = {
      affil: row.querySelector<HTMLElement>('.mr-affil'),
      tags: row.querySelector<HTMLElement>('.mr-tags'),
      metrics: row.querySelector<HTMLElement>('.mr-metrics'),
      links: row.querySelector<HTMLElement>('.mr-links'),
    };

    // Two persistent line wrappers the groups get shuffled between per stage.
    const line1 = document.createElement('div');
    const line2 = document.createElement('div');
    line1.className = 'mr-line';
    line2.className = 'mr-line';

    // Do a set of groups fit on ONE line of width `W` (with the between-group
    // gap)? Absent / empty groups are ignored.
    const fits = (ws: number[], W: number, gap: number) => {
      const p = ws.filter(x => x > 0);
      if (!p.length) return true;
      return p.reduce((s, x) => s + x, 0) + gap * (p.length - 1) <= W + 1;
    };

    // Move the given (present) groups, in order, into a line wrapper.
    const fill = (line: HTMLElement, gs: (HTMLElement | null)[]) => {
      for (const g of gs) if (g) line.appendChild(g);
    };

    let current = -1;

    const layout = () => {
      const W = row.clientWidth;
      if (!W) return; // hidden tab panel — re-runs via ResizeObserver when shown.
      const gap = px(getComputedStyle(row).columnGap);
      const A = naturalWidth(groups.affil);
      const T = naturalWidth(groups.tags);
      const M = naturalWidth(groups.metrics);
      const L = naturalWidth(groups.links);

      let stage: number;
      if (fits([A, T, M, L], W, gap)) stage = 0;
      else if (A > 0 && fits([T, M, L], W, gap)) stage = 1;
      else if (fits([T, L], W, gap)) stage = 2;
      else stage = 3;

      if (stage === current) return; // no change — avoid needless reflow / RO churn.
      current = stage;
      row.dataset.stage = String(stage);

      line1.textContent = '';
      line2.textContent = '';
      if (stage === 0) {
        fill(line1, [groups.affil, groups.tags, groups.metrics, groups.links]);
      } else if (stage === 1) {
        fill(line1, [groups.affil]);
        fill(line2, [groups.tags, groups.metrics, groups.links]);
      } else {
        // Stages 2 & 3 share one arrangement; the stage-3 difference (tags wrap,
        // links tie to the bottom tag row) falls out of line 2's flex-wrap.
        fill(line1, [groups.affil, groups.metrics]);
        fill(line2, [groups.tags, groups.links]);
      }
      row.appendChild(line1);
      if (line2.childElementCount) row.appendChild(line2);
      else if (line2.parentNode) line2.remove();
    };

    layout();
    if ('ResizeObserver' in window) {
      let raf = 0;
      const ro = new ResizeObserver(() => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(layout);
      });
      ro.observe(row);
    } else {
      window.addEventListener('resize', layout);
    }
  };

  document.querySelectorAll<HTMLElement>('.work-metarow').forEach(setup);

  // ── Institution key: no lone item on the last line ────────────────────────
  // When the key wraps, a single institution stranded on its own line reads as an
  // afterthought rather than part of the list, so the one before it is pulled down
  // to join it. Only when the line it leaves keeps at least two: with three items
  // over two lines every arrangement has a singleton somewhere, and trading "2 + 1"
  // for "1 + 2" is no improvement, so that case is left alone.
  const balanceKey = (key: HTMLElement) => {
    key.querySelectorAll('.affilkey-break').forEach(b => b.remove());
    const items = Array.from(key.querySelectorAll<HTMLElement>('.work-affil'));
    if (items.length < 3) return;
    const tops = items.map(i => Math.round(i.offsetTop));
    const last = tops[tops.length - 1];
    // All equal → one line (or a hidden tab panel, where every offsetTop is 0);
    // either way there's nothing to balance. A hidden panel re-runs on show.
    if (tops[0] === last) return;
    if (tops.filter(t => t === last).length !== 1) return;
    const prev = tops[tops.length - 2];
    if (tops.filter(t => t === prev).length < 3) return;
    // Break before the second-to-last item, so it wraps down with the orphan.
    const br = document.createElement('br');
    br.className = 'affilkey-break';
    key.insertBefore(br, items[items.length - 2]);
  };

  // ── Margin legend: follow the pointer from name to name ───────────────────
  // It shows only while a credited name is hovered — fading in at its fixed spot
  // rather than floating off the name — and each name lights the rows it carries,
  // so reading one after another walks the legend. Each name publishes its levels
  // as `data-levels` (see CreditMarks.astro) and each row names its own, so this
  // is a set test: no per-card data threading, and both mark families at once.
  document.querySelectorAll<HTMLElement>('.work-aside').forEach(aside => {
    const card = aside.closest('.work-card');
    if (!card) return;
    const rows = Array.from(aside.querySelectorAll<HTMLElement>('.wa-row'));
    const close = () => {
      aside.classList.remove('is-open');
      for (const r of rows) r.classList.remove('is-own');
    };
    const open = (target: EventTarget | null) => {
      const person = target instanceof Element ? target.closest<HTMLElement>('.cperson') : null;
      // Anywhere in the card that isn't a name closes it again — the legend
      // belongs to the names, not to the card as a whole.
      if (!person) return close();
      const levels = new Set((person.dataset.levels || '').split(' ').filter(Boolean));
      for (const r of rows) r.classList.toggle('is-own', levels.has(r.dataset.level || ''));
      aside.classList.add('is-open');
    };
    // mouseover (not mouseenter) so moving name→name re-fires without closing.
    card.addEventListener('mouseover', e => open(e.target));
    card.addEventListener('mouseleave', close);
    // Keyboard: names are links, so tabbing through them walks the legend too.
    card.addEventListener('focusin', e => open(e.target));
    card.addEventListener('focusout', close);
  });

  document.querySelectorAll<HTMLElement>('.work-affilkey').forEach(key => {
    balanceKey(key);
    if ('ResizeObserver' in window) {
      let raf = 0;
      const ro = new ResizeObserver(() => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => balanceKey(key));
      });
      ro.observe(key);
    } else {
      window.addEventListener('resize', () => balanceKey(key));
    }
  });
</script>

<style>
  .work-card {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .work-card:last-child {
    border-bottom: none;
  }

  /* ── Legend column (authorInstitutions.permanentLegend: 'aside') ────────────
     A column of its own in the page margin: absolutely positioned off the card,
     so the works column keeps exactly the width it has without one, and every
     card's legend starts at the same edge. Top-aligned with its item, so it reads
     as belonging to that card and not to the list.
       It's the popup's content at a fixed address rather than one that chases the
     cursor — hidden until a name is hovered, then faded in by `.is-open` (see the
     script). Only cards that HAVE a legend get one; `.work-main` is a plain block
     wrapper everywhere else and changes nothing. */
  .work-card.has-aside {
    position: relative;
  }

  .work-aside {
    position: absolute;
    top: 1.1rem; /* the card's own top padding — aligns with the first line */
    left: 100%;
    margin-left: 1.75rem;
    width: 12.5rem;
    display: grid;
    gap: 0.15rem;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--text-muted);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
  }

  .work-aside.is-open {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-aside {
      transition: none;
    }
  }

  /* A name too long for a 12.5rem column wraps, and its later lines hang clear of
     the mark instead of running back under it. A flex row rather than a text
     indent, because the indent would have to guess the mark's width: it varies per
     row (an emoji, a "††", a number), so any fixed value is wrong on most of them.
     The trailing name is an anonymous flex item, so it wraps inside its own box. */
  .wa-row {
    display: flex;
    align-items: baseline;
  }

  .wa-sym {
    flex: none;
    display: inline-block;
    min-width: 1em;
    margin-right: 0.35rem;
    color: var(--accent);
    font-weight: 700;
  }

  /* Same reason as the mark: an icon holds its width and the name wraps beside it. */
  .wa-row .affil-icon {
    flex: none;
  }

  /* Institutions are their own group, same gap the superscripts use. */
  .wa-row:not(.wa-org) + .wa-org {
    margin-top: 0.35rem;
  }

  /* Lit by the script below while the pointer is on a name that carries this
     row; the rest stay muted, present for context. */
  .wa-row.is-own {
    color: var(--text);
    font-weight: 600;
  }

  /* The margin only exists on a wide enough viewport: the content column is
     680px, so two ~14rem margins need ~1130px. Under that there is nowhere to put
     this, and the ordinary floating popup takes over instead (see .ctip in
     global.css, which is hidden the other way round above this width). */
  @media (max-width: 1149px) {
    .work-aside {
      display: none;
    }
  }

  /* ── Type row (Recent activity only) ───────────────────────────────────── */
  .work-typerow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.35rem;
  }

  /* Colour-keyed to the experience timeline via the inline --cat variable. */
  .work-kind {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--cat, var(--text-muted));
  }

  .work-kind::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 2px;
    background: var(--cat, var(--text-muted));
  }

  /* ── Header row: title (+ featured on single-type tabs) and date ───────── */
  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .work-title-wrap {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    min-width: 0;
  }

  /* The one canonical header style, shared by every Works view. */
  .work-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
  }

  .work-title a {
    color: var(--text);
    text-decoration: none;
  }

  .work-title a:hover {
    color: var(--accent);
  }

  .work-date {
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* "★ Featured" — on the type row in Recent activity, in the header elsewhere. */
  .featured-tag {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #d4a017;
    white-space: nowrap;
  }

  /* ── Body ──────────────────────────────────────────────────────────────── */
  .work-subtitle {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
    margin: 0.25rem 0 0;
  }

  .work-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 0.3rem 0 0;
  }

  /* Credited names (publications) — same muted weight as the blurb it replaced,
     with each name linking to that person's collaborators dropdown. */
  .work-authors {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0.3rem 0 0;
  }

  /* Me — bold, never a link. */
  .work-authors .me {
    color: var(--text);
    font-weight: 700;
  }

  .work-authors a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted var(--border);
  }

  .work-authors a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* The institution key under the author line — smaller and quieter than the
     names, since it's a footnote to them rather than content of its own. */
  .work-affilkey {
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.5;
    margin: 0.2rem 0 0;
    opacity: 0.85;
  }

  .work-affilkey .sep {
    margin: 0 0.4rem;
    opacity: 0.5;
  }

  /* Keep a number and its institution on one line — the separators are the only
     place this list may wrap. */
  .work-affil {
    white-space: nowrap;
  }

  /* The mark this row explains — an institution's emoji, or its fallback number.
     Not a <sup> here: in the key it's a label, not a superscript on a name. */
  .work-affil-mark {
    color: var(--accent);
    font-weight: 700;
    margin-right: 0.25rem;
  }

  .affil-icon {
    display: inline-block;
    margin-right: 0.25rem;
    font-size: 0.9em;
    line-height: 1;
    vertical-align: -0.05em;
  }

  img.affil-icon {
    width: 1em;
    height: 1em;
    object-fit: contain;
    vertical-align: -0.12em;
  }

  /* ── Meta row: affiliations · tags · metrics · links ───────────────────────
     Base state is a single wrapping flex row (this is also the no-JS fallback).
     The <script> above measures each card's own content and, only on overflow,
     reparents the groups into up to two `.mr-line` wrappers for the staged
     cascade (see the script header); `data-stage` records the current stage. */
  .work-metarow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-top: 0.6rem;
  }

  /* JS-built line wrapper — full-width so the (up to two) lines stack. Global
     because the script creates these nodes (they carry no scoped attribute). */
  :global(.work-metarow .mr-line) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    flex-basis: 100%;
